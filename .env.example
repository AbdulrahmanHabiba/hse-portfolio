# Neon pooled connection string (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon direct connection string (used by Prisma CLI: db push / migrate)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Session signing secret: openssl rand -base64 32
AUTH_SECRET=""

# First admin account (created by `npm run db:seed`)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-please"

# Public site URL (used for sitemap / metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
